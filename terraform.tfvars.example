# Proxmox 설정
proxmox_api_url = "https://your-proxmox:8006/api2/json"
proxmox_user = "terraform@pve"
proxmox_password = "your-password"
proxmox_tls_insecure = true

# SSH 키
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIB..."

# VM 기본 설정
vm_count = 3
vm_name_prefix = "gpu-vm"
vm_cores = 8
vm_memory = 8192
vm_disk_size = 200

# PCI Device 패스스루 설정
# 권장: 인덱스 기반 리스트로 지정 (vm_count와 동일/이하 길이)
pci_devices = [
  "0000:31:00.0",  # VM 1
  "0000:ca:00.0",  # VM 2
  ""               # VM 3 (미사용)
]

# (백워드 호환) 개별 변수도 지원
pci_device_1 = "0000:31:00.0"  # 첫 번째 VM에 할당할 PCI 디바이스
pci_device_2 = "0000:ca:00.0"  # 두 번째 VM에 할당할 PCI 디바이스  
pci_device_3 = ""              # 세 번째 VM은 PCI 디바이스 없음 (빈 값)

# PCI 디바이스 옵션
hostpci_pcie = true    # PCIe 모드 사용
hostpci_rombar = false # ROM BAR 비활성화 (GPU는 보통 false)

# 추가 디스크 설정 (옵션)
additional_disk_enabled = false
additional_disk_size = 500
additional_disk_storage = "local-lvm"
